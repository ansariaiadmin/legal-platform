{
  "name": "@legal-platform/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "test:migrations": "npm run migrate:up && npm run migrate:down:all && npm run migrate:up",
    "migrate:up": "node-pg-migrate --migration-file-language ts --migrations-dir src/database/migrations up",
    "migrate:down": "node-pg-migrate --migration-file-language ts --migrations-dir src/database/migrations down",
    "migrate:down:all": "node-pg-migrate --migration-file-language ts --migrations-dir src/database/migrations down 0",
    "migrate:create": "node-pg-migrate --migration-file-language ts --migrations-dir src/database/migrations create",
    "preflight": "ts-node src/preflight.ts"
  },
  "dependencies": {
    "@legal-platform/agent-civil-expert": "0.1.0",
    "@legal-platform/agent-criminal-expert": "0.1.0",
    "@legal-platform/agent-family-expert": "0.1.0",
    "@legal-platform/agent-legal-expert-base": "0.1.0",
    "@legal-platform/agent-registration-expert": "0.1.0",
    "@legal-platform/contracts": "1.0.0",
    "@legal-platform/domain": "1.0.0",
    "@legal-platform/shared": "1.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "@legal-platform/agent-international-expert": "1.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}