{
  "name": "@legal-platform/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "test:migrations": "echo 'Run migrations against live DB with DATABASE_URL set'",
    "migrate:up": "node-pg-migrate --migration-file-language ts --migrations-dir src/database/migrations up",
    "migrate:down": "node-pg-migrate --migration-file-language ts --migrations-dir src/database/migrations down",
    "migrate:create": "node-pg-migrate --migration-file-language ts --migrations-dir src/database/migrations create"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.0.0",
    "pg": "^8.13.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
