# =============================================================================
# Legal Platform (پلتفرم حقوقی) — environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` and adjust. `sudo ./setup.sh` does this automatically and
# replaces every `change_me` value below with a strong random secret.
#
# Values marked `change_me` are REJECTED when NODE_ENV=production.
# Never commit `.env`. Recommended permissions: chmod 600 .env
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Public URL users open in the browser (used in links sent by SMS/e-mail).
APP_URL=http://localhost:8080
# Comma-separated list of allowed browser origins for the API.
CORS_ORIGINS=http://localhost:8080

# --- Database (PostgreSQL 16 + pgvector) -------------------------------------
POSTGRES_USER=legal
POSTGRES_DB=legal_platform
POSTGRES_PASSWORD=change_me
# Must use the same password as POSTGRES_PASSWORD (setup.sh keeps them in sync).
DATABASE_URL=postgresql://legal:change_me@postgres:5432/legal_platform
# TLS to the database is off by default (the bundled container is on a private
# network). For a managed database use ?sslmode=require in DATABASE_URL, or:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Security secrets (generated by setup.sh) --------------------------------
# JWT signing keys — must be different from each other.
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
# 32-byte key, base64-encoded (openssl rand -base64 32). Encrypts provider
# credentials and other secrets at rest. Losing it makes that data unreadable.
ENCRYPTION_MASTER_KEY=change_me
# HMAC pepper for one-time passwords. Filled once by setup.sh; never rotate it
# while codes are in flight.
OTP_HASH_PEPPER=
OTP_TTL_SECONDS=120
# Optional dedicated secrets (fall back to derived keys when empty).
AREA_TICKET_SECRET=
MACHINE_TOKEN_SECRET=

# --- Office owner ------------------------------------------------------------
# Every account created by sign-in is a client. The account that signs in with
# this phone number (or email) receives the office-owner role and can open the
# dashboard. setup.sh asks for it; the number is normalized, so 0912..., +98912...
# and 98912... are all accepted.
OWNER_PHONE=
OWNER_EMAIL=

# --- Storage -----------------------------------------------------------------
# local = files on the `uploads` volume; pg = stored in PostgreSQL.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads

# --- AI ----------------------------------------------------------------------
# AI_PROVIDER: mock (no external calls, answers are clearly labelled) or
# openai-compatible (any OpenAI-compatible endpoint: cloud gateway or a local
# server such as Ollama / vLLM).
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_CLOUD_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=1024
# Optional on-premises model used before the cloud model (hybrid routing).
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
# Hosts the API may call for AI traffic (comma-separated). Empty = public hosts only.
AI_EGRESS_ALLOW=
# Spending guards (USD). Empty = no limit.
AI_MONTHLY_BUDGET_USD=
AI_MONTHLY_HARD_STOP_USD=
# Service tier preset: spartan | counsel | senator (see docs/AGENT_FLEET.md).
AGENT_TIER=counsel

# --- SMS ---------------------------------------------------------------------
# SMS_PROVIDER: mock | kavenegar | ghasedak
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
GHASEDAK_API_KEY=
GHASEDAK_LINE_NUMBER=

# --- Payments ----------------------------------------------------------------
# PAYMENT_PROVIDER: mock | zarinpal
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
# 1 = use the ZarinPal sandbox (ignored in production).
ZARINPAL_SANDBOX=0

# --- E-mail ------------------------------------------------------------------
# EMAIL_DRIVER: mock (writes to a local outbox) | smtp
EMAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 1 = force STARTTLS, 0 = disable; empty = automatic (on for port 587).
SMTP_STARTTLS=

# --- Other providers (mock until a real adapter is configured) ---------------
PUSH_PROVIDER=mock
TELEPHONY_PROVIDER=mock

# --- Operational alerts (optional) -------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# --- Backups (optional off-site copy, see docs/BACKUP.md) --------------------
BACKUP_ENCRYPTION_KEY=
BACKUP_RETAIN_DAYS=30
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Scaling (advanced) ------------------------------------------------------
# single = one API instance; multi = several instances behind a load balancer
# (requires RATE_LIMIT_DRIVER=redis).
DEPLOYMENT_MODE=single
RATE_LIMIT_DRIVER=
GLOBAL_RATE_LIMIT_PER_MIN=
SECURITY_HEADERS=on
