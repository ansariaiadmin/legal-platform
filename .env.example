# Environment Configuration
NODE_ENV=development

# Application URLs
APP_URL=http://localhost:8080
API_URL=http://localhost:8080/api
# Comma-separated CORS allow-list. APP_URL is always permitted; with neither
# set the API sends no CORS headers at all.
CORS_ORIGINS=

# Database
POSTGRES_USER=legal
POSTGRES_DB=legal_platform
# Rotated by scripts/install.sh — never ship this placeholder to a real box
POSTGRES_PASSWORD=legal_password_change_me
# NOTE: password must stay in sync with POSTGRES_PASSWORD above (installer does this)
DATABASE_URL=postgresql://legal:legal_password_change_me@postgres:5432/legal_platform

# Redis
REDIS_URL=redis://redis:6379

# Authentication Secrets (generate secure random values for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Encryption - must decode to exactly 32 bytes (base64, or 64 hex characters).
# Generate one with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=your_encryption_master_key_here
# OTP lifetime in seconds
OTP_TTL_SECONDS=120

# Storage Configuration
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads

# S3 Storage (optional, for offsite storage)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Provider Configuration (mock by default)
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
PUSH_PROVIDER=mock
TELEPHONY_PROVIDER=mock
AI_PROVIDER=mock

# AI Configuration
AI_ROUTING_MODE=iranian_gateway
AI_BASE_URL=
AI_API_KEY=
AI_EMBEDDING_DIMENSION=1024

# Agentic Layer (SPEC §11a, ADR-004)
# Hybrid inference: where agent brains run.
#   AI_HYBRID_POLICY: local_only | cloud_only | hybrid_local_first | hybrid_cloud_first
#   AI_LOCAL_BASE_URL: on-prem model endpoint (e.g. vLLM/Ollama). Empty = no local brain.
#   AI_MONTHLY_BUDGET_USD: empty = unmetered; 0 or depleted demotes hybrid to local.
#   AGENT_TIER: spartan | counsel | senator  — the purchasable tiers (docs/AGENT_FLEET.md).
AI_HYBRID_POLICY=hybrid_local_first
AI_LOCAL_BASE_URL=
AI_MONTHLY_BUDGET_USD=
AGENT_TIER=counsel

# Backup Configuration
BACKUP_DRIVER=local
BACKUP_LOCAL_PATH=/app/backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=14

# Logging
LOG_LEVEL=info

# Per-worker model brains (python sidecar; ADR-010/011). The FIRST match wins:
# PYLEGAL_LOCAL_* preferred over PYLEGAL_CLOUD_* when both are set.
PYLEGAL_LOCAL_MODEL_URL=
PYLEGAL_LOCAL_MODEL=
PYLEGAL_CLOUD_MODEL_URL=
PYLEGAL_CLOUD_MODEL=
PYLEGAL_CLOUD_MODEL_KEY=

# Leader default brains (used by Leader-lending when an agent has no pin)
AI_LOCAL_MODEL=
AI_CLOUD_MODEL=

# ── P2a: client site (ADR-015) ───────────────────────────────────────────
# Public URL of the client PWA (used as the callback / consult-link base).
APP_URL=http://localhost:3100
# Default consultation plans priced by the LAWYER from the telecoms tab;
# these factory defaults are only used until the dashboard edits them.
CONSULTATION_PLAN_PRICES_TOMAN=250000,450000,650000
# ── P1f: dashboard self-service (ADR-014) ────────────────────────────────
# SANDBOX ONLY: when set OUTSIDE production, a bearer equal to this secret
# maps to the fixed dev-owner (lawyer_owner) so the dashboard can be demoed
# without Postgres/Redis. Refused in production regardless of the value.
DEV_DASHBOARD_TOKEN=

# P3-T4 per-feature LLM quotas as JSON map ({}=uncapped dev default)
AI_FEATURE_QUOTA_TOKENS={}

# P4: rerank weights (JSON), usage pricing + alert
RAG_RERANK_WEIGHTS=
AI_TOKEN_PRICING_USD=
AI_MONTHLY_ALERT_THRESH_USD=

# ── P6: security hardening (ADR-021) ─────────────────────────────────────
# Security response headers: on | off (default on; HSTS only in production)
SECURITY_HEADERS=on
# Global per-IP rate floor per minute (feature limiters stay stricter)
GLOBAL_RATE_LIMIT_PER_MIN=300
# Guardian sweep cadence: daily default; 0 disables (tests)
SECURITY_SCAN_INTERVAL_MS=86400000
# Workers probe cadence for the dashboard health row (ms)
WORKER_PROBE_INTERVAL_MS=60000
# Deep code scan mode for the guardian report (deterministic worker scan)
SECURITY_DEEP_SCAN=0

# ── P8: deployment shape (ADR-023) ───────────────────────────────────────
# single (default) | multi — multi REQUIRES REDIS_URL to share bus/queues;
# otherwise /dashboard/ops/deployment reports the misconfig honestly.
DEPLOYMENT_MODE=single
# Area lock ticket signing secret (defaults to JWT_ACCESS_SECRET)
AREA_TICKET_SECRET=

# ── P9: durability, real gateways, shared limiter, tenant isolation ──────
# Runtime-state driver: local (default, single-box) | pg (durable, replica-
# shared; runs migration 008). Production with DATABASE_URL auto-picks pg.
STORAGE_DRIVER=local
# Per-office namespace for ALL persisted runtime state (both drivers).
# Lowercase/digits/hyphens, ≤63 chars. 'default' = unscoped legacy layout.
TENANT_SLUG=
# Rate-limit floor driver: memory (per-replica) | redis (shared; needs REDIS_URL).
RATE_LIMIT_DRIVER=
# Real gateways (mock providers are FORBIDDEN in production either way):
# ZarinPal — request/verify; paid only on code 100/101; no refund/query API.
PAYMENT_ADAPTER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=   # set 1 ONLY in non-production
# Kavenegar SMS
SMS_ADAPTER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# OpenAI-compatible AI cloud fallback (chat + embeddings)
AI_PROVIDER_KEY=    # openai-compatible enables the real adapter
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_CLOUD_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536
AI_HTTP_TIMEOUT_MS=20000

# ── P10: email auth factor + shared floor + event bridge ─────────────────
# EMAIL_DRIVER: mock (dev outbox, logs) | smtp (real relay, stdlib sockets)
EMAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587            # 465 = implicit TLS; 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM=               # sender identity shown to users
SMTP_STARTTLS=           # default: on for 587, off elsewhere
SMTP_TIMEOUT_MS=12000
# Event bus across replicas needs DEPLOYMENT_MODE=multi + REDIS_URL (pub/sub
# bridge live on legal:events:bus; loop guard = per-replica origin UUID)

# --- FIELD REVIEW 2026-09-05 remediation knobs -------------------------------
# Exit allowlist for cloud AI traffic — empty = any public HTTPS host.
AI_EGRESS_ALLOW=
# Wallet with a real payment gateway: JSON ledger is single-process; set this
# acknowledgement to silence the preflight warning once replicas==1 is real.
WALLET_REPLICA_OK=

# --- AI budget boundary knobs (Phase 11.5/12) --------------------------------
# Monthly TOKEN ledger cap — when real spend hits it, cloud inference demotes.
AI_MONTHLY_TOKEN_BUDGET=
# Monthly PRICED USD hard stop — drafting REFUSES instead of silently billing.
AI_MONTHLY_HARD_STOP_USD=

# --- Alerting (Phase 12) -----------------------------------------------------
# Generic Slack/Discord/Telegram-style webhook: critical bus events leave the box.
ALERT_WEBHOOK_URL=

# --- OTP sealing (Phase 12) --------------------------------------------------
# Dedicated pepper for OTP hashes; unset = legacy key (grace window for live codes).
OTP_HASH_PEPPER=
