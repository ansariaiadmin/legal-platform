# Environment Configuration
NODE_ENV=development

# Application URLs
APP_URL=http://localhost:8080
API_URL=http://localhost:8080/api
# Comma-separated CORS allow-list. APP_URL is always permitted; with neither
# set the API sends no CORS headers at all.
CORS_ORIGINS=

# Database
DATABASE_URL=postgresql://legal:legal_password_change_me@postgres:5432/legal_platform

# Redis
REDIS_URL=redis://redis:6379

# Authentication Secrets (generate secure random values for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Encryption - must decode to exactly 32 bytes (base64, or 64 hex characters).
# Generate one with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=your_encryption_master_key_here
# OTP lifetime in seconds
OTP_TTL_SECONDS=120

# Storage Configuration
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads

# S3 Storage (optional, for offsite storage)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Provider Configuration (mock by default)
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
PUSH_PROVIDER=mock
TELEPHONY_PROVIDER=mock
AI_PROVIDER=mock

# AI Configuration
AI_ROUTING_MODE=iranian_gateway
AI_BASE_URL=
AI_API_KEY=
AI_EMBEDDING_DIMENSION=1024

# Agentic Layer (SPEC §11a, ADR-004)
# Hybrid inference: where agent brains run.
#   AI_HYBRID_POLICY: local_only | cloud_only | hybrid_local_first | hybrid_cloud_first
#   AI_LOCAL_BASE_URL: on-prem model endpoint (e.g. vLLM/Ollama). Empty = no local brain.
#   AI_MONTHLY_BUDGET_USD: empty = unmetered; 0 or depleted demotes hybrid to local.
#   AGENT_TIER: spartan | counsel | senator  — the purchasable tiers (docs/AGENT_FLEET.md).
AI_HYBRID_POLICY=hybrid_local_first
AI_LOCAL_BASE_URL=
AI_MONTHLY_BUDGET_USD=
AGENT_TIER=counsel

# Backup Configuration
BACKUP_DRIVER=local
BACKUP_LOCAL_PATH=/app/backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=14

# Logging
LOG_LEVEL=info

# Per-worker model brains (python sidecar; ADR-010/011). The FIRST match wins:
# PYLEGAL_LOCAL_* preferred over PYLEGAL_CLOUD_* when both are set.
PYLEGAL_LOCAL_MODEL_URL=
PYLEGAL_LOCAL_MODEL=
PYLEGAL_CLOUD_MODEL_URL=
PYLEGAL_CLOUD_MODEL=
PYLEGAL_CLOUD_MODEL_KEY=

# Leader default brains (used by Leader-lending when an agent has no pin)
AI_LOCAL_MODEL=
AI_CLOUD_MODEL=
