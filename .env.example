# ============================================
# Legal Platform — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# برای وکیل — فقط ضروری‌ها — cp .env.example .env → ./install.sh
# ============================================

# --- دیتابیس — خودکار ---
DATABASE_URL=postgresql://legal:legal@localhost:5432/legal
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-openssl-rand-base64-32
ENCRYPTION_KEY=change-me-32-byte-base64
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# --- AI — 6 وکیل متخصص — با راهنما همون‌جا ---
# چیه؟ 6 وکیل AI: مدنی، کیفری، خانواده، ثبتی، بین‌الملل، عمومی — برای جواب حقوقی
# گزینه‌ها: openai (GPT-4), anthropic (Claude), google, mock (بدون AI — برای تست)
# کجا بگیرم؟ https://platform.openai.com/api-keys → sk-proj-...
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- SMS — پنل پیامکی — برای نوبت‌دهی موکل ---
# چیه؟ وقتی نوبت موکل می‌شه پیامک می‌ره: "نفر بعدی تویی"
# گزینه‌ها: ghasedak (https://ghasedak.me/ — رایگان 50 تا), kavenegar (https://kavenegar.com/), mock (تو لاگ)
# کجا بگیرم؟ https://ghasedak.me/ → ثبت‌نام → API Key
SMS_PROVIDER=mock
SMS_API_KEY=ghasedak-key
SMS_SENDER=10008566
GHASEDAK_API_KEY=ghasedak-key
KAVENEGAR_API_KEY=kavenegar-key

# --- Payment — پرداخت — زرین‌پال — برای فروش وقت مشاوره ---
# چیه؟ درگاه پرداخت ایرانی — موکل وقت می‌خره — پول می‌ره زرین‌پال
# گزینه‌ها: zarinpal (واقعی — https://next.zarinpal.com/ → API), mock (تست بدون پول)
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=

# --- Email — ایمیل ---
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=pass

# --- S3 — بکاپ offsite ---
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=access
S3_SECRET_KEY=secret
S3_BUCKET=legal-backups
BACKUP_ENCRYPTION_KEY=backup-enc-key-32-bytes

# --- Notification System — سیستم ناتیف — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی نوبت + پرداخت + موکل — کانال‌ها: in_app (همیشه روشن) + sms (نوبت موکل — مهم) + email + telegram (برای وکیل — موکل جدید)
# تلگرام: @BotFather → /newbot → توکن → chat_id
NOTIF_IN_APP=true
NOTIF_EMAIL=false
NOTIF_SMS=true
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PWA + E-Signature — سقف 10/10 — همیشه روشن ---
PWA_ENABLED=true
ESIGNATURE_ENABLED=true
TELEPHONY_PROVIDER=mock
PORT=3000
API_PORT=3001
LOG_LEVEL=info


# --- Fallback + Throttling — تاریکی روشن شد — v3.1.0 ---
# چیه؟ اگر یه پرووایدر خراب شد چی؟ fallback — اگر SMS fail شد in_app+email می‌ره — امن
# throttling چیه؟ اگر 5 SMS در 1 دقیقه بیاد خلاصه می‌شه — هزینه کنترل — spam جلوگیری
SMS_FALLBACK_PROVIDERS=ghasedak,kavenegar,mock
SMS_THROTTLING_ENABLED=true
SMS_THROTTLING_MAX_PER_MINUTE=5
NOTIF_FALLBACK_ENABLED=true
NOTIF_THROTTLING_ENABLED=true
NOTIF_THROTTLING_MAX_PER_MINUTE=10
NOTIF_THROTTLING_DIGEST_ENABLED=true
