{
  "name": "legal-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/domain",
    "packages/contracts",
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:packages": "npm run build -w @legal-platform/domain -w @legal-platform/contracts -w @legal-platform/shared",
    "build:apps": "npm run build -w @legal-platform/api -w @legal-platform/web",
    "build": "npm run build:packages && npm run build:apps",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @legal-platform/api",
    "migrate:up": "npm run migrate:up -w @legal-platform/api",
    "migrate:down": "npm run migrate:down -w @legal-platform/api"
  },
  "engines": {
    "node": ">=20"
  }
}
